# A resource is read at <PARQUET_BASE_URL>/<resource_id>.parquet
PARQUET_BASE_URL=https://hydra.s3.rbx.io.cloud.ovh.net/parquet
HTTP_TIMEOUT=20

# The data.gouv.fr instance of the resources: their `url` is its permalink to the source file
DATAGOUV_URL=https://www.data.gouv.fr

# Public URLs built in the responses
SERVER_NAME=localhost:8005
SCHEME=http

# Pagination and streaming
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=50
BATCH_SIZE=50000

# DuckDB
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=2GB
# faster on repeated queries, but a replaced parquet file stays cached until restart
DUCKDB_METADATA_CACHE=false
RESOURCE_CACHE_TTL=300
PROFILE_STATS=true

# Read-only SQL endpoint
SQL_MAX_ROWS=10000
SQL_TIMEOUT=30
SQL_MAX_LENGTH=10000

# SENTRY_DSN=
